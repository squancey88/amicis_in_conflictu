<%= render Common::ShowHeaderComponent.new(presenter: @presenter) %>

<%= render StandardLayoutBoxComponent.new(title: "Details") do |component| %>
  <%= render @campaign %>
<% end %>

<%= render StandardLayoutBoxComponent.new(title: "My Character") do |component| %>
  <ul class="list-group">
    <% current_user.characters.where(campaign: @campaign).each do |character| %>
      <li class="list-group-item">
        <%= link_to character.full_name, [@campaign.world, character] %>
      </li>
    <% end %>
  </ul>
<% end %>

<% if current_user == @campaign.game_master %>
  <%= render StandardLayoutBoxComponent.new(title: "Player Characters") do |component| %>
    <ul class="list-group">
      <% @campaign.player_users do |player_user| %>
        <li class="list-group-item">
          <%= player_user.display_name %>
        </li>
      <% end %>
    </ul>
  <% end %>
<% end %>

<% if @campaign.game_system.respond_to?(:campaign_list_attributes) && @campaign.game_master == current_user %>
  <%= render StandardLayoutBoxComponent.new(title: "Config") do |component| %>
    <h3>Config</h3>

    <% @campaign.game_system.campaign_list_attributes&.each do |attr| %>
      <p><%= attr["name"] %>: <%= @campaign.config[attr["key"]] %></p>
    <% end %>

  <% end %>
<% end %>
