
<%= content_tag :h1, @world.name %>

<div class="aic-grid">

  <%= render Common::EmbeddedIndexComponent.new(title: "Articles",
                                                react: true,
                                                display_config: [{attribute: :title}],
                                                records_path: api_world_articles_path(@world)) %>

  <%= render Common::EmbeddedIndexComponent.new(title: "Characters",
                                                react: true,
                                                display_config: [{attribute: :full_name}],
                                                records_path: api_world_characters_path(@world)) %>

  <%= render Common::EmbeddedIndexComponent.new(title: "Locations",
                                                react: true,
                                                display_config: [{attribute: :name}],
                                                records_path: api_world_locations_path(@world)) %>

  <%= render Common::EmbeddedIndexComponent.new(title: "Organisations", 
                                                react: true,
                                                display_config: [{attribute: :name}],
                                                records_path: api_world_organisations_path(@world)) %>

</div>
