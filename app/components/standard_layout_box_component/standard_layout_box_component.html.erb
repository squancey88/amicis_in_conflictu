<div class="<%= box_classes %>">
  <% if @title || menu %>
    <div class="header">
      <div class="text">
        <% if @title %>
          <h5 class="title"><%= @title %></h5>
        <% end %>
      </div>
      <% if menu %>
        <div class="menu">
          <%= menu %>
        </div>
      <% end %>
    </div>
  <% end %>
  <div class="<%= content_classes %>">
    <%= body %>
    <%= content %>
  </div>
</div>
