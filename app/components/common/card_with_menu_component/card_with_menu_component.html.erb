<div class="aic-card">
  <div class="header">
    <div class="text">
      <h5 class="title"><%= @title %></h5>
      <% if @subtitle %>
        <h6 class="subtitle"><%= @subtitle %></h6>
      <% end %>
    </div>
    <div class="menu">
      <%= menu_section if menu_section %>
      <% if @menu_options %>
        <%= render Common::MenuButtonComponent.new(menu_options: @menu_options) %>
      <% end %>
    </div>
  </div>
  <% if body %>
    <div class="body">
      <%= body %>
    </div>
  <% end %>
</div>
