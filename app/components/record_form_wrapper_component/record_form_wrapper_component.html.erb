<%= render ErrorPanelComponent.new(
  model_name: @record.model_name.human, 
  errors: @record.errors) %>

<%= render Common::PageHeaderComponent.new(presenter: @presenter) do |header| %>
  <%= header.with_control do %>
    <%= menu_items %>
    <%= @form.submit(class: "btn btn-primary") %>
  <% end %>
<% end %>

<% if notices.any? %>
  <div class="alert alert-secondary">
    <% notices.each do |notice| %>
      <%= notice %>
    <% end %>
  </div>
<% end %>

<%= tab_section if tab_section %>

<% if form_boxes %>
  <div class="record-form-wrapper__box_grid aic-grid">
    <% form_boxes.each do |box| %>
      <%= box %>
    <% end %>
  </div>
<% end %>
